# Non-secret deployment selection. Copy to /etc/swingpop/staging.env.
SWINGPOP_LOBBY_DOMAIN=lobby.example.com
# M19 verified the currently linked UGS environment name as "production".
# This names the UGS environment; it does not make the M20 service production-ready.
SWINGPOP_UGS_ENVIRONMENT=production
SWINGPOP_RELAY_REGION=asia-northeast1
SWINGPOP_RELAY_CONNECTION_TYPE=dtls

# The M16 development HMAC signing key is NOT stored here or in source control.
# Put its base64 value in /etc/swingpop/auth-key.txt with mode 0600 and owner swingpop.
# This is a staging-only authentication gate, not production account authentication.
